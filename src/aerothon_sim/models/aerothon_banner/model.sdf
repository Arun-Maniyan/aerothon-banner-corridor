<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- 11.5 ft x 1 ft ground banner. Long side along model X, so with yaw 0 it lies
       East-West (across the corridor mouth) and the text reads upright for a drone
       facing North (+Y). Texture background is exactly #00B140. -->
  <model name="aerothon_banner">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.002 0 0 0</pose>
        <geometry><box><size>3.5052 0.3048 0.004</size></box></geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>3.5052 0.3048</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://aerothon_banner/materials/textures/aerothon_banner.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
